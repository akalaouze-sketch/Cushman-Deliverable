# Copy this file to .env and fill in your keys. .env is gitignored and the keys
# stay server-side — never sent to the browser.

# Anthropic (Claude) — analyst + critic agents.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — secondary LLM.
OPENAI_API_KEY=sk-proj-...
OPENAI_VERIFY_MODEL=gpt-4.1

# FRED (Federal Reserve Economic Data).
FRED_API_KEY=

# Tavily — web search (assistant + research scripts). Optional.
TAVILY_API_KEY=

# NewsAPI (newsapi.org) — DFW CRE news aggregator (scripts/dfw_cre_news.py). Optional.
NEWSAPI_KEY=

# Census — richer ACS demographics. Optional.
CENSUS_API_KEY=

# Feedback → email. Easiest: get a free key at web3forms.com (just enter your email,
# no account) and set it here; submissions email that address.
WEB3FORMS_KEY=
# Alternatives (use ONE): Resend API, or SMTP (e.g. a Gmail App Password).
# RESEND_API_KEY=
# FEEDBACK_SMTP_USER=you@gmail.com
# FEEDBACK_SMTP_PASS=your-16-char-app-password
# FEEDBACK_TO=a.kalaouze@gmail.com   # where feedback is sent (Resend/SMTP)
